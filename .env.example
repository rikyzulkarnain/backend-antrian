# Backend env template. Copy to .env for local dev. Production values
# live in Railway dashboard env vars (see .agent/workflows/07-deployment).

# --- Required ---
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require
JWT_SECRET=replace-with-32-plus-bytes-base64

# --- Server ---
PORT=8080
CORS_ORIGINS=http://localhost:3000
# COOKIE_SECURE=true wajib di production (HTTPS). Default false agar dev di http://localhost jalan.
COOKIE_SECURE=false

# --- Cloudinary (untuk upload video signed) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_UPLOAD_FOLDER=sistem-antrian/videos
# Opsional: URL webhook notifikasi setelah upload selesai
CLOUDINARY_UPLOAD_HOOK=
